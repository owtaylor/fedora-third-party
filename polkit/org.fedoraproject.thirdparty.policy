<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC "-//freedesktop//DTD polkit Policy Configuration 1.0//EN"
"http://www.freedesktop.org/software/polkit/policyconfig-1.dtd">
<policyconfig>

  <vendor>Fedora Project</vendor>
  <vendor_url>https://pagure.io/fedora-third-party</vendor_url>

  <action id="org.fedoraproject.thirdparty.run">
    <description>Change third-party repository settings</description>
    <message>Authentication is required to configure software repositories</message>
    <icon_name>preferences-system</icon_name>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>auth_admin_keep</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/bin/fedora-third-party</annotate>
  </action>

</policyconfig>
